# Required for real sign-in (magic link OTP)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# npm run dev sets VITE_AUTH_BYPASS=false automatically.
# Do NOT set VITE_AUTH_BYPASS=true when testing Supabase auth — it injects a fake "Dev" user.

# Supabase Dashboard → Authentication → URL Configuration:
# Add http://localhost:5173 and your production URL to Redirect URLs.

# --- Server-side only (never VITE_ prefix) ---
# DeepSeek — used by POST /api/profiles/:id/generate-pathways in dev (Vite middleware)
DEEPSEEK_API_KEY=your_deepseek_api_key
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
