# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/pathwise

# OIDC (Auth0, Clerk, Keycloak, etc.)
OIDC_CLIENT_ID=
OIDC_ISSUER_URL=

# Public URLs (required in production)
PUBLIC_ORIGIN=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com,https://api.example.com
SEO_PUBLIC_ORIGIN=https://app.example.com

# API server
PORT=8080
NODE_ENV=development

# Frontend (pathwise-cc)
# PORT=19245
# BASE_PATH=/

# Object storage (GCS)
PRIVATE_OBJECT_DIR=/your-bucket/private
GCS_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCS_KEY_FILE=/path/to/service-account.json

# Third-party integrations
# AI (optional — pathways, chat, IGETC analysis, etc. return 503 until configured)
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=
TAVILY_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=

# E2E (Playwright only)
# E2E_API_PORT=8181
# E2E_WEB_PORT=19281
# ENABLE_E2E_TEST_ROUTES=true
# E2E_TEST_SECRET=
