{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development OIDC_CLIENT_ID=${OIDC_CLIENT_ID:-dev-client} OIDC_ISSUER_URL=${OIDC_ISSUER_URL:-https://example.com} PUBLIC_ORIGIN=${PUBLIC_ORIGIN:-http://localhost:19245} ALLOWED_ORIGINS=${ALLOWED_ORIGINS:-http://localhost:19245} PRIVATE_OBJECT_DIR=${PRIVATE_OBJECT_DIR:-/dev-bucket/private} && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:seo": "tsx src/scripts/generate-seo-pages.ts",
    "audit:seo": "tsx src/scripts/seo-audit.ts",
    "refresh:articulations": "tsx src/scripts/refresh-articulations.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@resvg/resvg-js": "^2.6.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/pathwise-deadlines": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "openid-client": "^6.8.4",
    "pdfkit": "^0.18.0",
    "pino": "^9",
    "pino-http": "^10",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^3.2.4"
  }
}
